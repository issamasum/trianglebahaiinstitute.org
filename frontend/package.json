{
  "name": "trianglebahaiinstitute",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host 0.0.0",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
      "test:ci": "ng test --configuration=ci --no-watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:export": "cd .. && uv run python scripts/export_openapi.py",
    "api:gen": "ng-openapi-gen",
    "api:sync": "pnpm api:export && pnpm api:gen",
    "mcp:angular": "ng mcp -E devserver",
    "serve:ssr:trianglebahaiinstitute": "node dist/trianglebahaiinstitute/server/server.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@angular/animations":"^22.1.5",
    "@angular/cdk": "^22.1.5",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "22.1.5",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.6",
    "express": "^5.1.0",
    "marked": "^18.0.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js":"^10.0.1",
    "@playwright/test":"^1.62.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^5.0.0",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "jsdom": "^28.0.0",
    "ng-openapi-gen": "^1.0.5",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
