    "/api/mytbi/me": {
      "get": {
        "tags": [
          "Authenticated User"
        ],
        "summary": "Get the authenticated user profile",
        "description": "Returns the authenticated user's profile.\n\nArgs:\n    subject: Authenticated subject resolved from the bearer token.\n\nReturns:\n    A UserProfile for the API.",
        "operationId": "get_current_subject_profile",
        "responses": {
          "200": {
            "description": "Profile details for the authenticated user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token is missing, invalid, or expired."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "patch": {
        "tags": [
          "Authenticated User"
        ],
        "summary": "Update the authenticated user's profile",
        "description": "Updates whichever fields are provided on the authenticated user's profile.\n\nFields omitted from the request body are left unchanged.\n\nArgs:\n    subject: TAuthenticated subject resolved from the bearer token.\n    body: Profile update payload.\n    user_repo: Repository used to persist the change.\n\nReturns:\n    The updated user profile.\n\nRaises:\n    HTTPException: If the requested email is already taken by another user.",
        "operationId": "update_current_subject_profile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The updated profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Bearer token is missing, invalid, or expired."
          },
          "409": {
            "description": "The requested email is already in use."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
